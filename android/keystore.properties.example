# Modello per la firma locale della release. NON inserire valori reali in questo file.
# Copialo in android/keystore.properties (ignorato da git) e compila i campi.
# storeFile e' relativo alla cartella android/ oppure assoluto; tieni il keystore
# FUORI dal repository e conservane una copia di backup sicura.
storeFile=C:/percorso/sicuro/historia-release.jks
storePassword=
keyAlias=historia-release
keyPassword=
